{
  "$schema": "https://raw.githubusercontent.com/nicepkg/vscode-tauri/main/schemas/tauri.conf.json",
  "productName": "LMPlus",
  "version": "2.5.0",
  "identifier": "com.meow.lmplus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LMPlus",
        "width": 450,
        "height": 440,
        "resizable": false,
        "maximizable": false,
        "visible": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.github.com/repos/MirahSyakilla/LMPlus/releases/latest"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMDA0MzVGMkNCRUI0NzQKUldSMHRMNHNYME1BWG1EWGxPdjF1ZkFkbFNmWUlWb3JxTTJ0UjhlTytJVUtSMnA5cVVsRFNMRTAK"
    },
    "shell": {
      "open": true
    }
  }
}
